generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PATIENT
  STAFF
  CLINIC_ADMIN
  SYSTEM_ADMIN
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

model Clinic {
  id            String        @id @default(cuid())
  slug          String        @unique
  nameKey       String        @map("name_key")
  publicName    String?       @map("public_name")
  locationKey   String        @map("location_key")
  publicAddress String?       @map("public_address")
  phone         String?
  email         String?
  websiteUrl    String?       @map("website_url")
  appointmentUrl String?      @map("appointment_url")
  sourceUrl     String?       @map("source_url")
  verifiedAt    DateTime?     @map("verified_at")
  timezone      String        @default("Africa/Mogadishu")
  active        Boolean       @default(true)
  services      Service[]
  providers     ClinicProvider[]
  users         User[]
  bookingRequests BookingRequest[]
  staffInvites   StaffInvite[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("clinics")
}

model ClinicProvider {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  displayName String   @map("display_name")
  specialty   String
  profileUrl  String?  @map("profile_url")
  sourceUrl   String   @map("source_url")
  active      Boolean  @default(true)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, displayName, specialty])
  @@index([clinicId, active])
  @@map("clinic_providers")
}

model Service {
  id              String             @id @default(cuid())
  clinicId        String             @map("clinic_id")
  slug            String
  nameKey         String             @map("name_key")
  durationMinutes Int                @map("duration_minutes")
  active          Boolean            @default(true)
  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  slots           AppointmentSlot[]
  bookingRequests BookingRequest[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@map("services")
}

model AppointmentSlot {
  id          String        @id @default(cuid())
  serviceId   String        @map("service_id")
  startsAt    DateTime      @map("starts_at")
  capacity    Int
  bookedCount Int           @default(0) @map("booked_count")
  active      Boolean       @default(true)
  source      String        @default("staff")
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([serviceId, startsAt])
  @@index([startsAt, active])
  @@map("appointment_slots")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         UserRole @default(PATIENT)
  clinicId     String?  @map("clinic_id")
  active       Boolean  @default(true)
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  sessions     LoginSession[]
  requests     BookingRequest[]
  systemSetup  SystemSetupState?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([clinicId, role, active])
  @@map("users")
}

model SystemSetupState {
  id            String   @id @default("singleton")
  systemAdminId String   @unique @map("system_admin_id")
  completedAt   DateTime @default(now()) @map("completed_at")
  systemAdmin   User     @relation(fields: [systemAdminId], references: [id], onDelete: Restrict)

  @@map("system_setup_state")
}

model LoginSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("login_sessions")
}

model StaffInvite {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  email     String
  clinicId  String   @map("clinic_id")
  role      UserRole @default(STAFF)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("staff_invites")
}

model BookingRequest {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  clinicId  String               @map("clinic_id")
  serviceId String               @map("service_id")
  startsAt  DateTime             @map("starts_at")
  phone     String
  source    String               @default("suggested")
  status    BookingRequestStatus @default(PENDING)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  service   Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([userId, status, startsAt])
  @@index([clinicId, status, startsAt])
  @@map("booking_requests")
}
